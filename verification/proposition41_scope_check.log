LogdetLean.GramHafnian.ThreePaper.RelativeAccuracy.collisionFreeLabelSpace_card (M N : ℕ) :
  Fintype.card (LogdetLean.GramHafnian.ThreePaper.RelativeAccuracy.CollisionFreeLabel M N) = M.choose N
LogdetLean.GramHafnian.ThreePaper.RelativeAccuracy.exactSectorScaleIdentity (r : ℝ) (M K n : ℕ) (w : ℂ) :
  LogdetLean.GramHafnian.LocalAnticoncentration.gbsProbabilityFromScaledAmplitude r M K n w *
      LogdetLean.GramHafnian.gramHafnianSigma K n ^ 2 =
    LogdetLean.GramHafnian.LocalAnticoncentration.gbsGaussianReferenceProbability r M K n * Complex.normSq w
