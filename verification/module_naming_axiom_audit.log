theorem UniformHiding.theorem3_2_route1.{u_1} : ∀ {Ω : Type u_1} [inst : MeasurableSpace Ω]
  (μ : MeasureTheory.Measure Ω) [MeasureTheory.IsProbabilityMeasure μ] (amplitude : Ω → ℂ),
  Measurable amplitude →
    ∀ (deltaP : Ω → ℝ) (H : LogdetLean.GramHafnian.LocalAnticoncentration.UnitaryHaarProbabilityFamily) {r : ℝ},
      0 < r →
        ∀ {M n K : ℕ},
          1 ≤ n →
            4 * n ≤ K →
              K ≤ M →
                ∀ {rho tau : ℝ},
                  0 < rho →
                    0 ≤ tau →
                      MeasureTheory.Measure.map amplitude μ =
                          LogdetLean.GramHafnian.LocalAnticoncentration.scaledHaarGramHafnianLaw H M n K →
                        μ.real
                            (LogdetLean.GramHafnian.LocalAnticoncentration.relativeFailureEvent deltaP
                              (fun ω =>
                                LogdetLean.GramHafnian.LocalAnticoncentration.gbsProbabilityFromScaledAmplitude r M K n
                                  (amplitude ω))
                              rho) ≤
                          UniformHiding.routeOneBound μ deltaP r M K n rho tau :=
fun {Ω} [MeasurableSpace Ω] μ [MeasureTheory.IsProbabilityMeasure μ] amplitude hamplitude deltaP H {r} hr {M n K} hn hK
    hKM {rho tau} hrho htau hmarginal =>
  have hM := Decidable.byContradiction fun a => UniformHiding.theorem3_2_route1._proof_1_1 hn hK hKM a;
  have hp :=
    LogdetLean.GramHafnian.ThreePaper.RelativeAccuracy.gbsGaussianReferenceProbability_pos hr hM
      (have this := Decidable.byContradiction fun a => UniformHiding.theorem3_2_route1._proof_1_2 hn hK a;
      this)
      n;
  let eta := tau / LogdetLean.GramHafnian.LocalAnticoncentration.gbsGaussianReferenceProbability r M K n;
  have heta := div_nonneg htau (LT.lt.le hp);
  have hscale := div_mul_cancel₀ tau (LT.lt.ne' hp);
  have ht := div_nonneg heta (LT.lt.le hrho);
  have hhaar := UniformHiding.routeOneSmallBall H hn hK hKM 0 (√(eta / rho)) (Real.sqrt_nonneg (eta / rho));
  have hadd :=
    of_eq_true
      (Eq.trans
        (congrFun'
          (congrArg LE.le
            (congrArg μ.real
              (congrArg Set.ofPred (funext fun omega => congrFun' (congrArg LT.lt hscale) |deltaP omega|))))
          (μ.real {omega | tau < |deltaP omega|}))
        (UniformHiding.theorem3_2_route1._simp_1_3 (μ.real {omega | tau < |deltaP omega|})));
  have h :=
    LogdetLean.GramHafnian.LocalAnticoncentration.randomizedConversion_from_finiteHaarSmallDenominator μ amplitude
      hamplitude deltaP H hr hM K n heta hrho MeasureTheory.measureReal_nonneg hmarginal hadd
      (LE.le.trans
        (Eq.mp
          (congrArg
            (fun _a =>
              (LogdetLean.GramHafnian.LocalAnticoncentration.scaledHaarGramHafnianLaw H M n K).real
                  (LogdetLean.GramHafnian.LocalAnticoncentration.scaledAmplitudeSmallDenominatorSet r M K n
                    (eta / rho)) ≤
                min 1 (LogdetLean.GramHafnian.LocalAnticoncentration.paperBkn K n * _a + UniformHiding.deltaOne M n))
            (Real.sq_sqrt ht))
          (Eq.mp
            (congrArg
              (fun _a =>
                (LogdetLean.GramHafnian.LocalAnticoncentration.scaledHaarGramHafnianLaw H M n K).real _a ≤
                  min 1
                    (LogdetLean.GramHafnian.LocalAnticoncentration.paperBkn K n * √(eta / rho) ^ 2 +
                      UniformHiding.deltaOne M n))
              (Eq.symm
                (LogdetLean.GramHafnian.LocalAnticoncentration.scaledAmplitudeSmallDenominatorSet_eq_shiftedComplexDisk
                  hr hM K n ht)))
            hhaar))
        (min_le_right 1
          (LogdetLean.GramHafnian.LocalAnticoncentration.paperBkn K n * (eta / rho) + UniformHiding.deltaOne M n)));
  have hratio :=
    id
      (Eq.mpr
        (id
          (congrArg
            (fun _a =>
              _a = tau / (rho * LogdetLean.GramHafnian.LocalAnticoncentration.gbsGaussianReferenceProbability r M K n))
            (div_div tau (LogdetLean.GramHafnian.LocalAnticoncentration.gbsGaussianReferenceProbability r M K n) rho)))
        (Eq.mpr
          (id
            (congrArg
              (fun _a =>
                tau / _a =
                  tau / (rho * LogdetLean.GramHafnian.LocalAnticoncentration.gbsGaussianReferenceProbability r M K n))
              (mul_comm (LogdetLean.GramHafnian.LocalAnticoncentration.gbsGaussianReferenceProbability r M K n) rho)))
          (Eq.refl
            (tau / (rho * LogdetLean.GramHafnian.LocalAnticoncentration.gbsGaussianReferenceProbability r M K n)))));
  id
    (Eq.mp
      (congrArg
        (LE.le
          (μ.real
            (LogdetLean.GramHafnian.LocalAnticoncentration.relativeFailureEvent deltaP
              (fun omega =>
                LogdetLean.GramHafnian.LocalAnticoncentration.gbsProbabilityFromScaledAmplitude r M K n
                  (amplitude omega))
              rho)))
        (congrArg (min 1)
          (congrFun'
            (congrArg HAdd.hAdd
              (congrArg
                (HAdd.hAdd
                  (μ.real
                    (LogdetLean.GramHafnian.ThreePaper.FairAbsoluteThresholdComparison.absoluteAdditiveFailureEvent
                      deltaP tau)))
                (congrArg (HMul.hMul (LogdetLean.GramHafnian.LocalAnticoncentration.paperBkn K n)) hratio)))
            (UniformHiding.deltaOne M n))))
      h)
theorem UniformHiding.theorem3_2_route1_optimized.{u_1} : ∀ {Ω : Type u_1} [inst : MeasurableSpace Ω]
  (μ : MeasureTheory.Measure Ω) [MeasureTheory.IsProbabilityMeasure μ] (amplitude : Ω → ℂ),
  Measurable amplitude →
    ∀ (deltaP : Ω → ℝ) (H : LogdetLean.GramHafnian.LocalAnticoncentration.UnitaryHaarProbabilityFamily) {r : ℝ},
      0 < r →
        ∀ {M n K : ℕ},
          1 ≤ n →
            4 * n ≤ K →
              K ≤ M →
                ∀ {rho : ℝ},
                  0 < rho →
                    MeasureTheory.Measure.map amplitude μ =
                        LogdetLean.GramHafnian.LocalAnticoncentration.scaledHaarGramHafnianLaw H M n K →
                      μ.real
                          (LogdetLean.GramHafnian.LocalAnticoncentration.relativeFailureEvent deltaP
                            (fun ω =>
                              LogdetLean.GramHafnian.LocalAnticoncentration.gbsProbabilityFromScaledAmplitude r M K n
                                (amplitude ω))
                            rho) ≤
                        UniformHiding.optimizedRouteOneBound μ deltaP r M K n rho :=
fun {Ω} [MeasurableSpace Ω] μ [MeasureTheory.IsProbabilityMeasure μ] amplitude hamplitude deltaP H {r} hr {M n K} hn hK
    hKM {rho} hrho hmarginal =>
  let this := Nonempty.intro ⟨0, le_refl 0⟩;
  le_ciInf fun tau =>
    UniformHiding.theorem3_2_route1 μ amplitude hamplitude deltaP H hr hn hK hKM hrho tau.property hmarginal
@[reducible] def UniformHiding.routeTwoConditional.{u_1} : ∀ {Omega : Type u_1} [inst : MeasurableSpace Omega]
  (mu : MeasureTheory.Measure Omega) [MeasureTheory.IsProbabilityMeasure mu] (deltaP : Omega → ℝ)
  (amplitude : Omega → ℂ),
  Measurable amplitude →
    ∀ {H : LogdetLean.GramHafnian.LocalAnticoncentration.UnitaryHaarProbabilityFamily}
      {Cprime pRefOne pRefTwo tau rho additiveFailureAtTau : ℝ} {M n K : ℕ}
      {symmetricMatrixLaw : MeasureTheory.Measure (Matrix (Fin (2 * n)) (Fin (2 * n)) ℂ)},
      1 ≤ n →
        2 * n ≤ K →
          K ≤ M →
            0 < pRefOne →
              0 < pRefTwo →
                0 ≤ tau →
                  0 < rho →
                    pRefOne =
                        LogdetLean.GramHafnian.ThreePaper.TwoMethodComparison.gramToSymmetricVarianceRatio K n *
                          pRefTwo →
                      LogdetLean.GramHafnian.ThreePaper.RelativeAccuracy.ShouSymmetricMatrixComparisonAt H M (2 * n) K
                          symmetricMatrixLaw Cprime →
                        LogdetLean.GramHafnian.ThreePaper.RelativeAccuracy.IndependentSymmetricHafnianSmallBallAt n
                            symmetricMatrixLaw →
                          MeasureTheory.Measure.map amplitude mu =
                              LogdetLean.GramHafnian.ThreePaper.RelativeAccuracy.routeTwoHaarHafnianLaw H M n K →
                            mu.real
                                  (LogdetLean.GramHafnian.ThreePaper.FairAbsoluteThresholdComparison.absoluteAdditiveFailureEvent
                                    deltaP tau) ≤
                                additiveFailureAtTau →
                              mu.real
                                  (LogdetLean.GramHafnian.LocalAnticoncentration.relativeFailureEvent deltaP
                                    (fun omega =>
                                      LogdetLean.GramHafnian.ThreePaper.RelativeAccuracy.routeTwoPhysicalProbabilityFromNormalizedHafnian
                                        pRefTwo n (amplitude omega))
                                    rho) ≤
                                min 1
                                  (additiveFailureAtTau +
                                      LogdetLean.GramHafnian.LocalAnticoncentration.paperBn n *
                                          LogdetLean.GramHafnian.ThreePaper.TwoMethodComparison.gramToSymmetricVarianceRatio
                                            K n *
                                        LogdetLean.GramHafnian.ThreePaper.FairAbsoluteThresholdComparison.commonAbsoluteThresholdRatio
                                          tau rho pRefOne +
                                    Cprime * ↑(2 * n) / √↑K) :=
@LogdetLean.GramHafnian.ThreePaper.RelativeAccuracy.routeTwoFairRelativeFailure_of_shou
